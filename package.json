{
  "name": "vscode-orion",
  "displayName": "vscode-orion",
  "description": "Language support for Orion programming language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "orion",
      "aliases": ["Orion", "orion"],
      "extensions": [".orion"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "orion",
      "scopeName": "source.orion",
      "path": "./syntaxes/orion.tmLanguage.json"
    }],
    "snippets": [{
      "language": "orion",
      "path": "./snippets/orion.json"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mastersam07/vscode-orion.git"
  },
  "keywords": [
    "orion",
    "language",
    "syntax",
    "highlighting"
  ],
  "icon": "images/icon.png",
  "license": "MIT"
}
