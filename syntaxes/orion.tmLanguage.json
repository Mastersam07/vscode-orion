{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Orion",
	"scopeName": "source.orion",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#literals"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.orion",
					"match": "//.*$",
					"comment": "Single line comments"
				},
				{
					"name": "comment.block.orion",
					"begin": "/\\*",
					"end": "\\*/",
					"comment": "Block comments"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.orion",
					"match": "\\b(if|else|elseif|while|for|break|continue|return)\\b"
				},
				{
					"name": "keyword.declaration.orion",
					"match": "\\b(var|fun|class)\\b"
				},
				{
					"name": "keyword.constant.orion",
					"match": "\\b(true|false|nil)\\b"
				},
				{
					"name": "keyword.other.orion",
					"match": "\\b(super|this)\\b"
				},
				{
					"name": "keyword.operator.orion",
					"match": "\\b(and|or)\\b"
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"name": "string.quoted.double.orion",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.orion",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "constant.numeric.orion",
					"match": "\\b\\d+(\\.\\d+)?\\b"
				},
				{
					"name": "variable.other.orion",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.orion",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.comparison.orion",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.assignment.orion",
					"match": "="
				},
				{
					"name": "keyword.operator.logical.orion",
					"match": "!|&&|\\|\\|"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.definition.array.begin.orion",
					"match": "\\["
				},
				{
					"name": "punctuation.definition.array.end.orion",
					"match": "\\]"
				},
				{
					"name": "punctuation.definition.block.begin.orion",
					"match": "{"
				},
				{
					"name": "punctuation.definition.block.end.orion",
					"match": "}"
				},
				{
					"name": "punctuation.definition.parameters.begin.orion",
					"match": "\\("
				},
				{
					"name": "punctuation.definition.parameters.end.orion",
					"match": "\\)"
				},
				{
					"name": "punctuation.terminator.statement.orion",
					"match": ";"
				},
				{
					"name": "punctuation.separator.delimiter.orion",
					"match": ","
				},
				{
					"name": "punctuation.accessor.orion",
					"match": "\\."
				}
			]
		}
	}
}