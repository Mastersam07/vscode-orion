{
    "comments": {
        "lineComment": "//",
        "blockComment": [
            "/*",
            "*/"
        ]
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string"
            ]
        }
    ],
    "surroundingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\""
        }
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(if|else|elseif|while|for|fun|class)\\b.*$",
        "decreaseIndentPattern": "^\\s*(else|elseif|\\})\\b.*$"
    },
    "folding": {
        "markers": {
            "start": "^\\s*//\\s*#region\\b",
            "end": "^\\s*//\\s*#endregion\\b"
        }
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "onEnterRules": [
        {
            "beforeText": "^\\s*\\/\\*.*$",
            "afterText": "^\\s*\\*\\/$",
            "action": {
                "indent": "indentOutdent",
                "removeText": 0
            }
        },
        {
            "beforeText": "^\\s*\\/\\*.*$",
            "action": {
                "indent": "indentOutdent",
                "appendText": " * "
            }
        },
        {
            "beforeText": "^\\s* \\*.*$",
            "action": {
                "indent": "indentOutdent",
                "appendText": " * "
            }
        }
    ]
}